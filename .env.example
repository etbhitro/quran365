# Скопируй этот файл в .env и впиши свои значения:  cp .env.example .env

# Токен Telegram-бота. Получить у @BotFather в Telegram (команда /newbot).
TELEGRAM_BOT_TOKEN=

# --- Опционально: аудио-проверка чтения (появится позже) -------------------
# Ключ OpenAI для распознавания речи (Whisper). Сейчас НЕ требуется —
# оставь пустым. Понадобится, когда включишь приём голосовых.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
# ---------------------------------------------------------------------------

# Язык перевода для сборки плана (ru.kuliev — перевод Э. Кулиева).
# Другие варианты см. http://api.alquran.cloud/v1/edition?language=ru
TRANSLATION_EDITION=ru.kuliev

# Сколько дней в плане (по умолчанию 365).
PLAN_DAYS=365
